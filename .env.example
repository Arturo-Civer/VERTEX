# ============================================================
# VERTEX — Variables de entorno
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena TODOS los valores en .env
#   3. NUNCA subas .env a git (ya está en .gitignore)
# ============================================================

# ------------------------------------------------------------
# BASE DE DATOS — VERTEX_DEMO (demostración)
# ------------------------------------------------------------
VERTEX_DEMO_SERVER=localhost,1433
VERTEX_DEMO_DB=VERTEX_DEMO
VERTEX_DEMO_SA_USER=app_demo_user
VERTEX_DEMO_SA_PWD=

# ------------------------------------------------------------
# BASE DE DATOS — VERTEX_REAL (producción)
# ------------------------------------------------------------
VERTEX_REAL_SERVER=localhost,1433
VERTEX_REAL_DB=VERTEX_REAL
VERTEX_REAL_SA_USER=app_real_user
VERTEX_REAL_SA_PWD=

# ------------------------------------------------------------
# SEGURIDAD
# ------------------------------------------------------------
# Clave secreta para firmar JWT. Genera un valor aleatorio largo:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Duración del token de acceso (ej: 15m, 1h, 8h)
JWT_EXPIRES_IN=8h

# ------------------------------------------------------------
# SERVIDOR
# ------------------------------------------------------------
NODE_ENV=development
PORT=3001

# ------------------------------------------------------------
# CONTRASEÑAS DE USUARIOS DEMO
# Usadas por: scripts/create_demo_users.ts
# NUNCA se almacenan en base de datos en texto plano.
# ------------------------------------------------------------
DEMO_PWD_ADMIN=
DEMO_PWD_ING_MANT=
DEMO_PWD_TEC_MEC=
DEMO_PWD_TEC_ELEC=
DEMO_PWD_DIR_PROD=
DEMO_PWD_CONSULTA=
DEMO_PWD_AUDITOR=

# ------------------------------------------------------------
# CONTRASEÑAS DE LOGINS SQL (para el instalador PowerShell)
# Solo se usan al ejecutar instalar.ps1 — no las necesita el backend.
# Puedes dejarlas vacías aquí y definirlas directamente en PowerShell:
#   $env:VERTEX_DEMO_APP_USER_PWD = "..."
#   $env:VERTEX_REAL_APP_USER_PWD = "..."
# ------------------------------------------------------------
VERTEX_DEMO_APP_USER_PWD=
VERTEX_REAL_APP_USER_PWD=
