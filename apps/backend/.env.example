# Copia este archivo como .env y completa los valores (.env no se sube a git)
DB_SERVER=localhost
DB_PORT=1433
DB_USER=app_demo_user
DB_PASSWORD=
DB_NAME=VERTEX_DEMO
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGIN=http://localhost:5173
# Poner en false si el servidor SQL tiene un certificado de confianza
DB_TRUST_SERVER_CERTIFICATE=true
