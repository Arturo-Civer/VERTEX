# Copia este archivo como .env para desarrollo local (.env no se sube a git)

# URL del backend (apps/backend)
VITE_API_URL=http://localhost:3000

# true solo en Netlify: login local con las credenciales demo, sin backend.
# Vite incluye las variables VITE_* en el JavaScript público del sitio, así
# que la contraseña demo debe ser desechable, nunca la de una cuenta real.
VITE_DEMO_MODE=false
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
